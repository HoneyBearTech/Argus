# Copy to .env and fill in. .env is gitignored.

# Grafana admin login (required).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Public URL Grafana is reached at (used for links and redirects).
GRAFANA_ROOT_URL=http://localhost:3000

# Which Argus images to run. Pin ARGUS_VERSION to a release (e.g. 0.1.0) for
# predictable upgrades; ARGUS_REGISTRY can be docker.io/<user> instead of GHCR.
ARGUS_VERSION=latest
ARGUS_REGISTRY=ghcr.io/honeybeartech

# Run from this checkout instead of the published images, so edits to
# dashboards/, provisioning/ and the configs apply without a rebuild
# (see docker-compose.source.yml). Uncomment for development.
#COMPOSE_FILE=docker-compose.yml:docker-compose.source.yml

# Host address:port each service is published on. The defaults listen on all
# interfaces, because agents on other hosts push to Prometheus and Loki. For a
# sandbox on your own machine, use 127.0.0.1 instead.
GRAFANA_BIND=0.0.0.0:3000
PROMETHEUS_BIND=0.0.0.0:9090
LOKI_BIND=0.0.0.0:3101

# Prometheus retention: whichever limit is hit first wins.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# Optional services to start (comma-separated compose profiles):
#   loki — the log store (or run logs/compose.yml on another host and set LOKI_URL)
#   snmp — snmp-exporter, needs secrets/snmp-auth.yml
#   radarr, radarr4k, sonarr, sonarr4k, lidarr, bazarr, prowlarr, sabnzbd —
#     exportarr for that app, needs secrets/<profile>.env (URL, API_KEY)
#   qbittorrent — qbittorrent-exporter, needs secrets/qbittorrent.env
# Also list each enabled media exporter in targets/media.json.
#   gitlab — gitlab-ci-pipelines-exporter, needs secrets/gitlab.yml and
#     secrets/gitlab.env; list it in targets/gitlab.json
COMPOSE_PROFILES=loki

# Discord webhook for alert notifications (production only; leave unset in a
# sandbox so it can't post to the real channel).
DISCORD_WEBHOOK_URL=

# unpoller verifies the UniFi console's TLS certificate. A console still on its
# factory self-signed certificate fails that check: give it a trusted
# certificate, or set this to false to accept any certificate.
UNIFI_VERIFY_SSL=true

# Loki base URL for Grafana's Loki datasource. Leave unset to use the bundled
# Loki (`loki` profile); set it when Loki runs on another host.
LOKI_URL=
