# Copy to .env and fill in. .env is gitignored.

# Grafana admin login (required).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Public URL Grafana is reached at (used for links and redirects).
GRAFANA_ROOT_URL=http://localhost:3000

# Host address:port each service is published on.
# Sandbox: keep both on 127.0.0.1. Production: Grafana on 0.0.0.0:3000 so the
# reverse proxy can reach it; Prometheus stays on 127.0.0.1.
GRAFANA_BIND=127.0.0.1:3000
PROMETHEUS_BIND=127.0.0.1:9090

# Prometheus retention: whichever limit is hit first wins.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# Optional services to start (comma-separated compose profiles):
#   snmp — snmp-exporter, needs secrets/snmp-auth.yml
#   radarr, radarr4k, sonarr, sonarr4k, lidarr, bazarr, prowlarr, sabnzbd —
#     exportarr for that app, needs secrets/<profile>.env (URL, API_KEY)
#   qbittorrent — qbittorrent-exporter, needs secrets/qbittorrent.env
# Also list each enabled media exporter in targets/media.json.
COMPOSE_PROFILES=

# Discord webhook for alert notifications (production only; leave unset in a
# sandbox so it can't post to the real channel).
DISCORD_WEBHOOK_URL=
