# Varken settings: each app's address as host:port, without http(s)://. The API
# keys are secrets/tautulli_api_key and exportarr's secrets/{sonarr,sonarr4k,
# radarr,radarr4k}_api_key. SSL=true for https; VERIFY_SSL=true to check the
# certificate. Server 1 is Sonarr / Radarr, server 2 their 4K instances.
VRKN_TAUTULLI_1_URL=tautulli.example:8181
VRKN_TAUTULLI_1_SSL=false
VRKN_TAUTULLI_1_VERIFY_SSL=false
VRKN_SONARR_1_URL=sonarr.example:8989
VRKN_SONARR_1_SSL=false
VRKN_SONARR_1_VERIFY_SSL=false
VRKN_SONARR_2_URL=sonarr4k.example:8989
VRKN_SONARR_2_SSL=false
VRKN_SONARR_2_VERIFY_SSL=false
VRKN_RADARR_1_URL=radarr.example:7878
VRKN_RADARR_1_SSL=false
VRKN_RADARR_1_VERIFY_SSL=false
VRKN_RADARR_2_URL=radarr4k.example:7878
VRKN_RADARR_2_SSL=false
VRKN_RADARR_2_VERIFY_SSL=false
