# Telegraf's vSphere input: vCenter's SDK URL and a read-only vCenter account (a vsphere.local user
# with the Read-only role as a global permission, propagated). vCenter's CA certificate goes in
# secrets/vsphere-ca.pem: download https://<vcenter>/certs/download.zip and copy certs/lin/<hash>.0.
VSPHERE_URL=https://vcenter.example/sdk
VSPHERE_USERNAME=argus@vsphere.local
VSPHERE_PASSWORD=password
