# Secrets and local config
.env
*.env
!.env.example
# Placeholder env files are meant to be committed
!secrets.example/*.env
# Prometheus scrape targets are host-specific (see targets.example/)
targets/
# Internal names the repo checks forbid (they can't be committed either)
.forbidden-patterns
secrets/
*.key
*.pem

# Grafana runtime data (if you run a local test instance)
data/
grafana.db
*.log

# Jsonnet/Grafonnet build output and vendored libs
build/
vendor/
jsonnetfile.lock.json

# Editor/OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
