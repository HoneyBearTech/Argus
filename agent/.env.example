# Copy to .env next to compose.yml.
# Name this host reports as (shows up as the `host` label in every dashboard).
ARGUS_HOST=my-host
# Where the Argus server's Prometheus and Loki listen.
ARGUS_PROMETHEUS_URL=http://argus-server.example:9090
ARGUS_LOKI_URL=http://argus-server.example:3101
# Optional: the server's secrets/prometheus_password, once Prometheus requires
# a password (secrets/prometheus-web.yml on the server).
ARGUS_PROMETHEUS_PASSWORD=
# Optional: Nginx Proxy Manager's data/logs directory, on the host that runs it.
NPM_LOG_DIR=
# Optional profiles: plex (Plex exporter; Plex hosts only, amd64).
COMPOSE_PROFILES=
PLEX_SERVER=
PLEX_TOKEN=
