            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deadlocks and refused logins",
      "description": "Deadlocks per second in either engine, and MariaDB connections that failed to log in. PostgreSQL's refused logins are in its log (Logs dashboard).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (host) (rate(pg_stat_database_deadlocks{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "PostgreSQL deadlocks ({{host}})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (host) (rate(mysql_global_status_innodb_deadlocks{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "MariaDB deadlocks ({{host}})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (host) (rate(mysql_global_status_aborted_connects{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "MariaDB refused logins ({{host}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
