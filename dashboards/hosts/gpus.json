{
  "id": null,
  "uid": "argus-gpus",
  "title": "GPUs",
  "description": "Are the GPUs doing the transcoding, and are they healthy?",
  "tags": [
    "argus",
    "hosts",
    "gpu"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
      "type": "dashboards",
      "tags": [
        "argus"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(nvidia_smi_gpu_info, host)",
        "query": {
          "query": "label_values(nvidia_smi_gpu_info, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPUs",
      "description": "NVIDIA GPUs reporting through the GPU exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(nvidia_smi_gpu_info{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Encoder busy",
      "description": "The busiest GPU's video encoder (NVENC): transcodes writing video (Tdarr, Plex).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * max(nvidia_smi_utilization_encoder_ratio{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Decoder busy",
      "description": "The busiest GPU's video decoder (NVDEC): transcodes reading video.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * max(nvidia_smi_utilization_decoder_ratio{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Encoder sessions",
      "description": "Video encoding sessions open on all GPUs: one per running hardware transcode.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(nvidia_smi_encoder_stats_session_count{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hottest GPU",
      "description": "The hottest GPU's core temperature. Orange from 80 \u00b0C, red from 85 \u00b0C (the alert).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nvidia_smi_temperature_gpu{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Power",
      "description": "Power all GPUs draw together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(nvidia_smi_power_draw_watts{job=\"gpu\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 7,
      "type": "table",
      "title": "GPUs",
      "description": "Each GPU now. GPU: its compute engines (transcode filters, tone mapping). Encoder and decoder: the video engines a hardware transcode uses. Sessions: open encoding sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (host, uuid, name, driver_version) (nvidia_smi_gpu_info{job=\"gpu\", host=~\"$host\"}), \"key\", \"/\", \"host\", \"uuid\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(100 * nvidia_smi_utilization_gpu_ratio{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(100 * nvidia_smi_utilization_encoder_ratio{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(100 * nvidia_smi_utilization_decoder_ratio{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(nvidia_smi_encoder_stats_session_count{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(100 * nvidia_smi_memory_used_bytes{job=\"gpu\", host=~\"$host\"} / nvidia_smi_memory_total_bytes{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "F",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(nvidia_smi_memory_total_bytes{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "G",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(nvidia_smi_temperature_gpu{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "H",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(nvidia_smi_power_draw_watts{job=\"gpu\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"uuid\"))",
          "refId": "I",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No GPUs reporting"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GPU"
            },
            "properties": [
