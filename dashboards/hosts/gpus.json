    {
      "id": 8,
      "type": "timeseries",
      "title": "Video encoder and decoder",
      "description": "How busy each GPU's video engines are: the encoder (NVENC) writes, the decoder (NVDEC) reads. A hardware transcode shows on both.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * nvidia_smi_utilization_encoder_ratio{job=\"gpu\", host=~\"$host\"} * on (host, uuid) group_left (name, index) nvidia_smi_gpu_info{job=\"gpu\", host=~\"$host\"}",
          "refId": "A",
          "range": true,
          "legendFormat": "{{host}} #{{index}} encoder"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * nvidia_smi_utilization_decoder_ratio{job=\"gpu\", host=~\"$host\"} * on (host, uuid) group_left (name, index) nvidia_smi_gpu_info{job=\"gpu\", host=~\"$host\"}",
          "refId": "B",
          "range": true,
          "legendFormat": "{{host}} #{{index}} decoder"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
