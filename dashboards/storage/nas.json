  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "NAS units",
      "description": "One row per NAS. Fans shows the worse of the system and CPU fan. Memory excludes cache and buffers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, modelName) (modelName{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, version) (version{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (systemStatus{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (powerStatus{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (max(systemFanStatus{job=\"snmp\", host=~\"$host\"}) by (host) > max(cpuFanStatus{job=\"snmp\", host=~\"$host\"}) by (host) or max(systemFanStatus{job=\"snmp\", host=~\"$host\"}) by (host))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (temperature{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (100 - ssCpuIdle{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (100 * (memTotalReal{job=\"snmp\", host=~\"$host\"} - memAvailReal{job=\"snmp\", host=~\"$host\"} - memBuffer{job=\"snmp\", host=~\"$host\"} - memCached{job=\"snmp\", host=~\"$host\"}) / memTotalReal{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (upgradeAvailable{job=\"snmp\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
