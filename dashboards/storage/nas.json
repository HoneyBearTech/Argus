  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "NAS",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(systemStatus{job=\"snmp\"}, host)",
        "query": {
          "query": "label_values(systemStatus{job=\"snmp\"}, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
