    {
      "id": 3,
      "type": "table",
      "title": "Disks",
      "description": "Every disk. Bad sectors shows n/a where the drive doesn't report them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(label_replace(max by (host, diskID, diskModel) (diskModel{job=\"snmp\", host=~\"$host\"}), \"disk\", \"Disk $1$2\", \"diskID\", \"0x4469736B203(\\\\d)(?:3(\\\\d))?\"), \"key\", \"/\", \"host\", \"disk\")",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(label_replace(diskStatus{job=\"snmp\", host=~\"$host\"}, \"disk\", \"Disk $1$2\", \"diskID\", \"0x4469736B203(\\\\d)(?:3(\\\\d))?\"), \"key\", \"/\", \"host\", \"disk\"))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(label_replace(diskHealthStatus{job=\"snmp\", host=~\"$host\"}, \"disk\", \"Disk $1$2\", \"diskID\", \"0x4469736B203(\\\\d)(?:3(\\\\d))?\"), \"key\", \"/\", \"host\", \"disk\"))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(label_replace(diskTemperature{job=\"snmp\", host=~\"$host\"}, \"disk\", \"Disk $1$2\", \"diskID\", \"0x4469736B203(\\\\d)(?:3(\\\\d))?\"), \"key\", \"/\", \"host\", \"disk\"))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(label_replace(diskBadSector{job=\"snmp\", host=~\"$host\"}, \"disk\", \"Disk $1$2\", \"diskID\", \"0x4469736B203(\\\\d)(?:3(\\\\d))?\"), \"key\", \"/\", \"host\", \"disk\"))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "NAS"
