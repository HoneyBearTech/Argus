    {
      "id": 2,
      "type": "table",
      "title": "Storage pools",
      "description": "Each RAID volume / storage pool. 'Full in' extrapolates the last 24 hours of growth \u2014 it needs a day of data and shows '> 1 year' when the pool isn't filling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (host, raidName) (raidStatus{job=\"snmp\", host=~\"$host\"}), \"key\", \"/\", \"host\", \"raidName\")",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(100 * (1 - raidFreeSize{job=\"snmp\", host=~\"$host\"} / raidTotalSize{job=\"snmp\", host=~\"$host\"}), \"key\", \"/\", \"host\", \"raidName\"))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(raidFreeSize{job=\"snmp\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"raidName\"))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(raidTotalSize{job=\"snmp\", host=~\"$host\"}, \"key\", \"/\", \"host\", \"raidName\"))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(raidFreeSize{job=\"snmp\", host=~\"$host\"} / clamp_min(-deriv(raidFreeSize{job=\"snmp\", host=~\"$host\"}[24h]), 0.001) / 86400, \"key\", \"/\", \"host\", \"raidName\"))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Normal",
                        "color": "green",
                        "index": 0
                      },
                      "2": {
                        "text": "Repairing",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "Migrating",
                        "color": "blue",
