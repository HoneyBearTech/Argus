        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (library) (varken_tautulli_library_items{item=\"episodes\", server=~\"$server\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (library) (varken_tautulli_library_items{item=\"albums\", server=~\"$server\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (library) (varken_tautulli_library_items{item=\"tracks\", server=~\"$server\"})",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 0,
          "noValue": "No libraries reporting"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "library",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "indexByName": {
              "library": 0,
              "type": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "library": "Library",
              "type": "Type",
              "Value #A": "Items",
              "Value #B": "Seasons",
              "Value #C": "Episodes",
              "Value #D": "Albums",
              "Value #E": "Tracks"
            }
          }
        }
