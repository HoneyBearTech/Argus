{
  "id": null,
  "uid": "argus-tautulli",
  "title": "Tautulli",
  "description": "What's playing on Plex right now, and how is it being delivered?",
  "tags": [
    "argus",
    "media",
    "tautulli"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
      "type": "dashboards",
      "tags": [
        "argus"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(varken_job_up{service=\"tautulli\"}, server)",
        "query": {
          "query": "label_values(varken_job_up{service=\"tautulli\"}, server)",
          "refId": "server"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "container",
        "label": "Container",
        "type": "textbox",
        "description": "The Varken container's name, for its CPU and logs.",
        "query": "argus-varken-.*",
        "current": {
          "text": "argus-varken-.*",
          "value": "argus-varken-.*"
        },
        "options": [
          {
            "selected": true,
            "text": "argus-varken-.*",
            "value": "argus-varken-.*"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tautulli",
      "description": "Whether Varken's last read of Tautulli's current activity worked. Down: Tautulli isn't answering, or its API key is wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(varken_job_up{service=\"tautulli\", job=\"activity\", server=~\"$server\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reporting",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "index": 0
                },
                "0": {
                  "text": "Down",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Streams",
      "description": "Streams playing, paused or buffering now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(varken_tautulli_streams{server=~\"$server\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reporting",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Transcodes",
      "description": "Streams the server is transcoding: these cost CPU or GPU time.",
      "datasource": {
        "type": "prometheus",
