    {
      "id": 17,
      "type": "table",
      "title": "Library sizes",
      "description": "Each library's size: movies, shows or artists, and the seasons, episodes, albums and tracks in them. Read once an hour by default.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (library, type) (varken_tautulli_library_items{item=\"total\", server=~\"$server\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (library) (varken_tautulli_library_items{item=\"seasons\", server=~\"$server\"})",
