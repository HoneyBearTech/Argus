    {
      "id": 10,
      "type": "table",
      "title": "Current sessions",
      "description": "What's playing now, counted by state, media type, how it's delivered, quality and platform. Who is watching, and what, is only exported with Varken's stream_details setting, which Argus leaves off.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state, media_type, transcode_decision, video_decision, quality, platform) (varken_tautulli_sessions{server=~\"$server\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 0,
          "noValue": "Nothing playing"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "state": 0,
              "media_type": 1,
              "transcode_decision": 2,
              "video_decision": 3,
              "quality": 4,
              "platform": 5,
              "Value": 6
            },
            "renameByName": {
              "state": "State",
              "media_type": "Type",
              "transcode_decision": "Delivery",
              "video_decision": "Video",
              "quality": "Quality",
              "platform": "Platform",
              "Value": "Sessions"
            }
          }
        }
      ],
      "interval": "30s"
    },
