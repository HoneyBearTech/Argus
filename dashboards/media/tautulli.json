      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(varken_tautulli_streams_by_decision{decision=\"transcode\", server=~\"$server\"})",
          "refId": "A",
