        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "hostname": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "hostname": "Pi-hole",
              "Value #A": "Queries / s",
              "Value #B": "Queries (24 h)",
              "Value #C": "Blocked",
              "Value #D": "Cache hits",
