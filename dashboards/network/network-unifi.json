    {
      "id": 15,
      "type": "table",
      "title": "Weak Wi-Fi clients",
      "description": "Wireless clients with a signal weaker than -67 dBm \u2014 the usual threshold for reliable Wi-Fi. Weakest first.",
      "datasource": {
