      "gridPos": {
        "x": 7,
        "y": 30,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort(avg by (name, band) (max by (name, band, vap_name) (unpoller_device_vap_satisfaction_ratio{usage=\"user\"} >= 0)) * 100)",
          "legendFormat": "{{name}} {{band}} GHz",
          "refId": "A",
          "instant": true,
          "range": false
