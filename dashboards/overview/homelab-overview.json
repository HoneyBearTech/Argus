    {
      "id": 7,
      "type": "table",
      "title": "Services down",
      "description": "Each failing service with the HTTP status the proxy returned: 0 = no response at all; 502 = the proxy couldn't reach the service; 403 = the proxy's access list refused the prober (fix the access list, the service itself may be fine).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_http_status_code{job=\"blackbox_http\", group=~\"$group\"} and on (instance) (probe_success{job=\"blackbox_http\", group=~\"$group\"} == 0)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Every service is up"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {
              "service": 0,
              "group": 1,
              "Value": 2,
              "instance": 3
            },
            "renameByName": {
              "service": "Service",
              "group": "Group",
              "Value": "HTTP status",
              "instance": "URL"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Hosts and DNS down",
      "description": "Hosts failing their ping, and Pi-holes failing to resolve.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(monitor_status == 0, \"name\", \"$1\", \"monitor_name\", \"(.*)\") or label_replace(probe_success{job=\"blackbox_dns\"} == 0, \"name\", \"$1 (DNS)\", \"service\", \"(.*)\")",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All hosts and DNS servers are up"
