        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Down"
            }
          }
        }
      ]
    },
