    {
      "id": 5,
      "type": "stat",
      "title": "Certificate expires in",
      "description": "Days until the soonest-expiring certificate served by the reverse proxy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min((probe_ssl_last_chain_expiry_timestamp_seconds{job=\"blackbox_http\"} - time()) / 86400)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: days",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
