{
  "id": null,
  "uid": "argus-gitlab-ci",
  "title": "GitLab CI",
  "description": "Are pipelines healthy, and is the runner keeping up?",
  "tags": [
    "argus",
    "ci"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(gitlab_ci_pipeline_id, project)",
        "query": {
          "query": "label_values(gitlab_ci_pipeline_id, project)",
          "refId": "project"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
      "type": "dashboards",
      "tags": [
        "argus"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failing",
      "description": "Branches and tags whose most recent pipeline failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(gitlab_ci_pipeline_status{project=~\"$project\", status=\"failed\"} == 1 and ignoring (status) (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id))) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pipelines run",
      "description": "New pipelines seen in the selected time range, on the branches and tags the exporter watches.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(changes((max by (project, kind, ref) (gitlab_ci_pipeline_id{project=~\"$project\"}))[$__range:1m])) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Since last pipeline",
      "description": "Time since any watched pipeline last changed (started, finished or moved to another stage).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(gitlab_ci_pipeline_timestamp{project=~\"$project\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Longest job wait",
      "description": "How long the slowest job in the most recent runs waited for a runner. Long waits mean the runner is busy, offline or missing a tag the job needs. Over 1 min is orange, over 5 min red.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(gitlab_ci_pipeline_job_queued_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id)))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Projects watched",
      "description": "Projects the exporter found with its token (every project the token's user can see).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(gcpe_projects_count)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Exporter",
      "description": "Whether Prometheus can scrape gitlab-ci-pipelines-exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"gitlab\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "Not set up"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "30s"
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest pipeline per branch",
      "description": "The most recent pipeline on each watched branch and tag (by default main/master and every tag).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (project, kind, ref, source, status) (gitlab_ci_pipeline_status{project=~\"$project\"} == 1 and ignoring (status) (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id))), \"key\", \"/\", \"project\", \"kind\", \"ref\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(gitlab_ci_pipeline_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)), \"key\", \"/\", \"project\", \"kind\", \"ref\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(gitlab_ci_pipeline_queued_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)), \"key\", \"/\", \"project\", \"kind\", \"ref\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(time() - (gitlab_ci_pipeline_timestamp{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id))), \"key\", \"/\", \"project\", \"kind\", \"ref\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(gitlab_ci_pipeline_id{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)), \"key\", \"/\", \"project\", \"kind\", \"ref\"))",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No pipelines yet",
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "Passed",
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "text": "Failed",
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "text": "Running",
                        "color": "blue",
                        "index": 2
                      },
                      "pending": {
                        "text": "Pending",
                        "color": "orange",
                        "index": 3
                      },
                      "created": {
                        "text": "Created",
                        "color": "blue",
                        "index": 4
                      },
                      "preparing": {
                        "text": "Preparing",
                        "color": "blue",
                        "index": 5
                      },
                      "waiting_for_resource": {
                        "text": "Waiting for resource",
                        "color": "orange",
                        "index": 6
                      },
                      "scheduled": {
                        "text": "Scheduled",
                        "color": "blue",
                        "index": 7
                      },
                      "manual": {
                        "text": "Manual",
                        "color": "text",
                        "index": 8
                      },
                      "canceling": {
                        "text": "Canceling",
                        "color": "text",
                        "index": 9
                      },
                      "canceled": {
                        "text": "Canceled",
                        "color": "text",
                        "index": 10
                      },
                      "skipped": {
                        "text": "Skipped",
                        "color": "text",
                        "index": 11
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trigger"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "push": {
                        "text": "Push",
                        "index": 0
                      },
                      "schedule": {
                        "text": "Schedule",
                        "index": 1
                      },
                      "web": {
                        "text": "Run pipeline",
                        "index": 2
                      },
                      "api": {
                        "text": "API",
                        "index": 3
                      },
                      "trigger": {
                        "text": "Trigger",
                        "index": 4
                      },
                      "merge_request_event": {
                        "text": "Merge request",
                        "index": 5
                      },
                      "pipeline": {
                        "text": "Parent pipeline",
                        "index": 6
                      },
                      "parent_pipeline": {
                        "text": "Parent pipeline",
                        "index": 7
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Waited"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Updated"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pipeline"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Updated",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "key": true,
              "kind": true,
              "Value #A": true
            },
            "indexByName": {
              "project": 0,
              "ref": 1,
              "source": 2,
              "status": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7
            },
            "renameByName": {
              "project": "Project",
              "ref": "Branch / tag",
              "source": "Trigger",
              "status": "Status",
              "Value #B": "Duration",
              "Value #C": "Waited",
              "Value #D": "Updated",
              "Value #E": "Pipeline"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Pipeline status history",
      "description": "Status of the most recent pipeline on each branch over time; every red stretch is a failed run that stayed the latest until the next pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (project, ref) (((gitlab_ci_pipeline_status{project=~\"$project\", status=\"success\"} == 1) * 1 or (gitlab_ci_pipeline_status{project=~\"$project\", status=~\"created|preparing|waiting_for_resource|pending|running|scheduled\"} == 1) * 2 or (gitlab_ci_pipeline_status{project=~\"$project\", status=\"failed\"} == 1) * 3 or (gitlab_ci_pipeline_status{project=~\"$project\", status=~\"manual|canceling|canceled|skipped\"} == 1) * 0) and ignoring (status) (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)))",
          "refId": "A",
          "legendFormat": "{{project}} \u00b7 {{ref}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Canceled / skipped",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "Passed",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Running",
                  "color": "blue",
                  "index": 2
                },
                "3": {
                  "text": "Failed",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "30s"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pipeline duration",
      "description": "How long the most recent pipeline on each branch took. Each step is a new pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (project, ref) (gitlab_ci_pipeline_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)))",
          "refId": "A",
          "legendFormat": "{{project}} \u00b7 {{ref}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "30s"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Waiting for a runner",
      "description": "How long each branch's most recent pipeline waited before its first job started, and the longest wait of any job in the latest runs. Rising waits mean the runner isn't keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (project, ref) (gitlab_ci_pipeline_queued_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_id == on (project, kind, ref) group_left max by (project, kind, ref) (gitlab_ci_pipeline_id)))",
          "refId": "A",
          "legendFormat": "{{project}} \u00b7 {{ref}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(gitlab_ci_pipeline_job_queued_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id)))",
          "refId": "B",
          "legendFormat": "Longest job wait"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Longest job wait"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "30s"
    },
    {
      "id": 11,
      "type": "table",
      "title": "Latest run of each job",
      "description": "Every job the watched pipelines have run, as of its most recent run. A job removed from .gitlab-ci.yml stays listed until the exporter restarts; its Started time shows it's stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (project, kind, ref, stage, job_name, status, failure_reason, runner_description) (gitlab_ci_pipeline_job_status{project=~\"$project\"} == 1 and ignoring (status) (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id))), \"key\", \"/\", \"project\", \"kind\", \"ref\", \"stage\", \"job_name\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(gitlab_ci_pipeline_job_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id)), \"key\", \"/\", \"project\", \"kind\", \"ref\", \"stage\", \"job_name\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(gitlab_ci_pipeline_job_queued_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id)), \"key\", \"/\", \"project\", \"kind\", \"ref\", \"stage\", \"job_name\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(time() - (gitlab_ci_pipeline_job_timestamp{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id))), \"key\", \"/\", \"project\", \"kind\", \"ref\", \"stage\", \"job_name\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No jobs yet",
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "Passed",
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "text": "Failed",
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "text": "Running",
                        "color": "blue",
                        "index": 2
                      },
                      "pending": {
                        "text": "Pending",
                        "color": "orange",
                        "index": 3
                      },
                      "created": {
                        "text": "Created",
                        "color": "blue",
                        "index": 4
                      },
                      "preparing": {
                        "text": "Preparing",
                        "color": "blue",
                        "index": 5
                      },
                      "waiting_for_resource": {
                        "text": "Waiting for resource",
                        "color": "orange",
                        "index": 6
                      },
                      "scheduled": {
                        "text": "Scheduled",
                        "color": "blue",
                        "index": 7
                      },
                      "manual": {
                        "text": "Manual",
                        "color": "text",
                        "index": 8
                      },
                      "canceling": {
                        "text": "Canceling",
                        "color": "text",
                        "index": 9
                      },
                      "canceled": {
                        "text": "Canceled",
                        "color": "text",
                        "index": 10
                      },
                      "skipped": {
                        "text": "Skipped",
                        "color": "text",
                        "index": 11
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Waited"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Started",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "key": true,
              "kind": true,
              "Value #A": true
            },
            "indexByName": {
              "project": 0,
              "ref": 1,
              "stage": 2,
              "job_name": 3,
              "status": 4,
              "failure_reason": 5,
              "runner_description": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9
            },
            "renameByName": {
              "project": "Project",
              "ref": "Branch / tag",
              "stage": "Stage",
              "job_name": "Job",
              "status": "Status",
              "failure_reason": "Failure reason",
              "runner_description": "Runner",
              "Value #B": "Duration",
              "Value #C": "Waited",
              "Value #D": "Started"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Job duration",
      "description": "How long the most recent run of each job took.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (project, job_name) (gitlab_ci_pipeline_job_duration_seconds{project=~\"$project\"} and (gitlab_ci_pipeline_job_id == on (project, kind, ref, stage, job_name) group_left max by (project, kind, ref, stage, job_name) (gitlab_ci_pipeline_job_id)))",
          "refId": "A",
          "legendFormat": "{{project}} \u00b7 {{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "30s"
    }
  ]
}
