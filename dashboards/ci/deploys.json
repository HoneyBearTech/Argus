{
  "id": null,
  "uid": "argus-deploys",
  "title": "Deploys",
  "description": "Did every merge reach its host, and is every host's deploy agent alive?",
  "tags": [
    "argus",
    "ci",
    "deploys"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
      "type": "dashboards",
      "tags": [
        "argus"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(homelab_pull_info, host)",
        "query": {
          "query": "label_values(homelab_pull_info, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "stack",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(homelab_pull_info{host=~\"$host\"}, stack)",
        "query": {
          "query": "label_values(homelab_pull_info{host=~\"$host\"}, stack)",
          "refId": "stack"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stacks",
      "description": "Stacks whose homelab-pull reports through this host's Argus agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (host, stack) (homelab_pull_info{job=\"node\", host=~\"$host\", stack=~\"$stack\"}))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Behind main",
      "description": "Stacks whose deployed commit isn't what their branch points at: a deploy failing, paused, or in progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (host, stack) (homelab_pull_up_to_date{job=\"node\", host=~\"$host\", stack=~\"$stack\"}) == 0) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failing",
      "description": "Stacks whose last deploy attempt failed (and no later one succeeded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (host, stack) (homelab_pull_deploy_failing{job=\"node\", host=~\"$host\", stack=~\"$stack\"}) == 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Paused",
      "description": "Stacks whose checkout isn't on its branch (pinned to a tag or another branch by hand), so merges don't deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (host, stack) (homelab_pull_paused{job=\"node\", host=~\"$host\", stack=~\"$stack\"}) == 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Agents silent",
      "description": "Stacks whose homelab-pull hasn't finished a run for 50 minutes while the host still reports: a stopped timer or a broken install. It runs every ~90 s, but writes its metrics when a run ends, and one run (a deploy with big image pulls) may take up to 45 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - max by (host, stack) (homelab_pull_last_run_timestamp_seconds{job=\"node\", host=~\"$host\", stack=~\"$stack\"}) > 3000) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Deploys",
      "description": "Successful deploys in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "",
          "expr": "sum(count_over_time({job=\"homelab-pull\", host=~\"$host\", stack=~\"$stack\", result=~\"ok\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed attempts",
      "description": "Deploy attempts that failed in the selected time range (each retry counts).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "",
          "expr": "sum(count_over_time({job=\"homelab-pull\", host=~\"$host\", stack=~\"$stack\", result=~\"failed:.+\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 8,
      "type": "table",
      "title": "Stacks",
      "description": "One row per stack, from the metrics file homelab-pull rewrites after every run. In sync: the deployed commit is what the branch points at. Last run: Error when it failed before deploying (GitHub unreachable, bad settings) or the deploy failed. Took: the last successful deploy, from fast-forward to healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (host, stack, version) (homelab_pull_info{job=\"node\", host=~\"$host\", stack=~\"$stack\"}), \"key\", \"/\", \"host\", \"stack\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key, commit) (label_join(homelab_pull_deployed_info{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(homelab_pull_up_to_date{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(homelab_pull_paused{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\")) + 2 * max by (key) (label_join(homelab_pull_deploy_failing{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key, kind) (label_join(homelab_pull_deploy_failure_info{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(homelab_pull_last_run_success{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "F",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(time() - homelab_pull_last_run_timestamp_seconds{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "G",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(time() - homelab_pull_last_deploy_timestamp_seconds{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "H",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (key) (label_join(homelab_pull_last_deploy_duration_seconds{job=\"node\", host=~\"$host\", stack=~\"$stack\"}, \"key\", \"/\", \"host\", \"stack\"))",
          "refId": "I",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No stacks reporting"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Deployed commit"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "In sync"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Yes",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "No",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Paused",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Failing",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "Failing, paused",
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Error",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ran"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last deploy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Took"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true,
              "key": true,
              "Value #A": true,
              "Value #B": true,
              "Value #E": true
            },
            "indexByName": {
              "stack": 0,
              "host": 1,
              "version": 2,
              "commit": 3,
              "Value #C": 4,
              "Value #D": 5,
              "kind": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 10
            },
            "renameByName": {
              "stack": "Stack",
              "host": "Host",
              "version": "Agent",
              "commit": "Deployed commit",
              "Value #C": "In sync",
              "Value #D": "State",
              "kind": "Failure",
              "Value #F": "Last run",
              "Value #G": "Ran",
              "Value #H": "Last deploy",
              "Value #I": "Took"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Stack"
              }
            ]
          }
        }
      ],
      "interval": "1m"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Deploys per day",
      "description": "Successful deploys per stack and day, and failed attempts (red), from each stack's deploys.log.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{stack}}",
          "expr": "sum by (stack) (count_over_time({job=\"homelab-pull\", host=~\"$host\", stack=~\"$stack\", result=\"ok\"}[$__interval]))"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "queryType": "range",
          "legendFormat": "failed",
          "expr": "sum(count_over_time({job=\"homelab-pull\", host=~\"$host\", stack=~\"$stack\", result=~\"failed:.+\"}[$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1d"
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Deploy duration",
      "description": "How long each stack's last successful deploy took, from fast-forward to every service healthy (image pulls included, the prune after it not).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (stack) (homelab_pull_last_deploy_duration_seconds{job=\"node\", host=~\"$host\", stack=~\"$stack\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{stack}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No deploy yet"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "interval": "1m"
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Deploy log",
      "description": "One line per deploy attempt, newest first: time, stack, result (ok or failed:<kind>), old -> new commit, the commit's subject, and the services recreated or the space pruned.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"homelab-pull\", host=~\"$host\", stack=~\"$stack\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
