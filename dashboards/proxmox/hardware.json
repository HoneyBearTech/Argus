{
  "id": null,
  "uid": "argus-hardware",
  "title": "Server Hardware",
  "description": "Is the server hardware healthy: temperatures, fans, power supplies, batteries, power draw, and room in the BMCs' event logs?",
  "tags": [
    "argus",
    "proxmox",
    "hardware"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Argus dashboards",
      "type": "dashboards",
      "tags": [
        "argus"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Proxmox VE",
      "type": "link",
      "url": "/d/argus-proxmox",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "includeVars": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(ipmi_up{job=\"ipmi\"}, host)",
        "query": {
          "query": "label_values(ipmi_up{job=\"ipmi\"}, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BMCs not answering",
      "description": "Servers whose BMC didn't answer every collector at the last scrape. Their sensors aren't being checked.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(min by (host) (ipmi_up{job=\"ipmi\", host=~\"$host\"}) < 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical sensors",
      "description": "Sensors in critical state: a failed battery, power supply or fan, or a reading past its critical limit. Empty slots and Supermicro's LED pattern sensors don't count. Details in Sensors not nominal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count({__name__=~\"ipmi_(sensor|temperature|fan_speed|voltage|current|power)_state\", job=\"ipmi\", host=~\"$host\", type!=\"Entity Presence\", name!~\"Pattern[0-9]+\"} == 2) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warning sensors",
      "description": "Sensors in warning state: a reading past its warning limit, or redundancy reduced.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count({__name__=~\"ipmi_(sensor|temperature|fan_speed|voltage|current|power)_state\", job=\"ipmi\", host=~\"$host\", type!=\"Entity Presence\", name!~\"Pattern[0-9]+\"} == 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Power draw",
      "description": "What the selected servers draw together, from each BMC's live (DCMI) power reading.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ipmi_dcmi_power_consumption_watts{job=\"ipmi\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hottest inlet",
      "description": "The warmest air going into a server: Dell's Inlet Temp, Supermicro's System Temp. Orange from 30 \u00b0C, red from 38 \u00b0C.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ipmi_temperature_celsius{job=\"ipmi\", host=~\"$host\", name=~\"Inlet Temp|System Temp\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 38
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Event log space left",
      "description": "Free space in the fullest BMC event log. At zero the BMC records no new hardware events: save the log and clear it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(ipmi_sel_free_space_bytes{job=\"ipmi\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1024
              },
              {
                "color": "green",
                "value": 4096
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "table",
      "title": "Servers",
      "description": "One row per server. BMC: whether every collector could read it. Power: the BMC's live (DCMI) reading. Inlet: Dell's Inlet Temp or Supermicro's System Temp. Hottest CPU: Dell's CPU sensors are named Temp, Supermicro's CPUn Temp. Sensors not OK: in warning or critical state, not counting empty slots (Entity Presence) or Supermicro's LED pattern sensors. A BMC stops recording events when its event log is full.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (host) (ipmi_up{job=\"ipmi\", host=~\"$host\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (ipmi_dcmi_power_consumption_watts{job=\"ipmi\", host=~\"$host\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (ipmi_temperature_celsius{job=\"ipmi\", host=~\"$host\", name=~\"Inlet Temp|System Temp\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (ipmi_temperature_celsius{job=\"ipmi\", host=~\"$host\", name=~\"Temp|CPU[0-9]* Temp\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (host) (ipmi_fan_speed_rpm{job=\"ipmi\", host=~\"$host\"})",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (host) ({__name__=~\"ipmi_(sensor|temperature|fan_speed|voltage|current|power)_state\", job=\"ipmi\", host=~\"$host\", type!=\"Entity Presence\", name!~\"Pattern[0-9]+\"} > 0) or on (host) (max by (host) (ipmi_up{job=\"ipmi\", host=~\"$host\"}) * 0)",
          "refId": "F",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (ipmi_sel_logs_count{job=\"ipmi\", host=~\"$host\"})",
          "refId": "G",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (host) (ipmi_sel_free_space_bytes{job=\"ipmi\", host=~\"$host\"})",
          "refId": "H",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, manufacturer_id, firmware_revision, system_firmware_version) (ipmi_bmc_info{job=\"ipmi\", host=~\"$host\"})",
          "refId": "I",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No server reporting"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BMC"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Not answering",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
