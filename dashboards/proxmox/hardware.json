    {
      "id": 8,
      "type": "table",
      "title": "Sensors not nominal",
      "description": "Every sensor the BMCs report in warning or critical state, the same ones the Hardware sensor alerts watch: empty slots (Entity Presence) and Supermicro's PatternN LED sensors are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, name, id, type) ({__name__=~\"ipmi_(sensor|temperature|fan_speed|voltage|current|power)_state\", job=\"ipmi\", host=~\"$host\", type!=\"Entity Presence\", name!~\"Pattern[0-9]+\"} > 0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Every sensor is nominal"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Warning",
                        "color": "orange",
                        "index": 0
                      },
                      "2": {
                        "text": "Critical",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "State",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "name": 1,
              "type": 2,
              "id": 3,
              "Value": 4
            },
            "renameByName": {
              "host": "Server",
              "name": "Sensor",
              "type": "Type",
              "id": "Sensor id",
              "Value": "State"
            }
          }
        }
      ]
    },
    {
