{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^docker-compose.*\\.ya?ml$/",
      "/^agent\\/compose\\.ya?ml$/",
      "/^logs\\/compose\\.ya?ml$/"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github\\/workflows\\/.*\\.ya?ml$/"
    ]
  },
  "gitlabci": {
    "managerFilePatterns": [
      "/^\\.gitlab-ci\\.yml$/"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Literal docker run image operands in workflow shell blocks",
      "managerFilePatterns": [
        "/^\\.github/workflows/(ci|scan)\\.yml$/"
      ],
      "matchStrings": [
        "(?m)^(?<prefix>[ \\t]*(?:run:[ \\t]*)?(?:docker run\\b[^\\n]*?[ \\t]+)?(?:--entrypoint[ \\t]+[^ \\t]+[ \\t]+)?)(?<depName>(?:rhysd/actionlint|hadolint/hadolint|grafana/alloy|prom/prometheus|prom/snmp-exporter|prom/blackbox-exporter|grafana/loki|aquasec/trivy)):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?<separator>\\s|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "depNameTemplate": "{{depName}}"
    },
    {
      "customType": "regex",
      "description": "Shared Argus release defaults",
      "managerFilePatterns": [
        "/^\\.env\\.example$/",
        "/^docker-compose\\.yml$/",
        "/^logs\\/compose\\.yml$/",
        "/^agent\\/compose\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)ARGUS_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\r?\\n|$)",
        "ARGUS_VERSION:-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\}",
        "ARGUS_(?:AGENT|INTEL_GPU_EXPORTER)_IMAGE:-ghcr\\.io/honeybeartech/argus-(?:agent|intel-gpu-exporter):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\}"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "HoneyBearTech/Argus",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchPackageNames": [
        "/^(?:.*\\/)?argus-/"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "enabled": false
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/^agent\\/Dockerfile$/",
      "/^images\\/(grafana|prometheus|blackbox|loki|intel-gpu-exporter)\\/Dockerfile$/"
    ]
  },
  "automerge": false,
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements-dev\\.txt$/"
    ]
  }
}
