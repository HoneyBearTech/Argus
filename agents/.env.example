# Per-host settings for agents/compose.yml (copy to .env next to compose.yml).
# Optional profiles: logs (Alloy → Loki), plex (Plex exporter, Plex hosts only).
COMPOSE_PROFILES=logs
# Name this host's logs are labelled with (match the `host` label in targets/node.json).
ARGUS_HOST=host
LOKI_URL=http://loki-host.example:3101
# Only on the Nginx Proxy Manager host: its data/logs directory.
NPM_LOG_DIR=
# Only on a Plex host (with the plex profile).
PLEX_SERVER=
PLEX_TOKEN=
