// Grafana Alloy: ships this host's Docker container logs to Loki, plus Nginx
// Proxy Manager access logs on the host that runs it. Settings come from the
// agent's .env: LOKI_URL, ARGUS_HOST and (optionally) NPM_LOG_DIR.

loki.write "argus" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
  external_labels = {
    host = sys.env("ARGUS_HOST"),
  }
}

// ── Container logs ──────────────────────────────────────────────────────
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { job = "docker" }
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
  // On first start Alloy reads each container's whole log history; Loki
  // rejects anything older than a week anyway, so only ship the last hour.
  stage.drop {
    older_than          = "1h"
    drop_counter_reason = "too_old"
  }
  forward_to = [loki.write.argus.receiver]
}

// ── Nginx Proxy Manager access logs (only where NPM_LOG_DIR is mounted) ──
local.file_match "npm" {
  path_targets = [{
    "__path__" = "/var/log/npm/proxy-host-*_access.log",
    "job"      = "npm",
  }]
}

loki.source.file "npm" {
  targets       = local.file_match.npm.targets
  tail_from_end = true
  forward_to    = [loki.process.npm.receiver]
}

loki.process "npm" {
  // Argus' own uptime probes would otherwise dominate the traffic.
  stage.drop {
    expression = ".*Blackbox-Exporter.*"
  }

  // [04/Oct/2026:18:07:35 +0000] - 302 302 - GET https site.example "/" [Client 1.2.3.4] [Length 29] ...
  stage.regex {
    expression = "^\\[(?P<time>[^\\]]+)\\] \\S+ \\S+ (?P<status>\\S+) - (?P<method>\\S+) \\S+ (?P<site>\\S+) \"[^\"]*\" \\[Client [^\\]]+\\] \\[Length \\d+\\]"
  }
  stage.timestamp {
    source = "time"
    format = "02/Jan/2006:15:04:05 -0700"
  }
  stage.labels {
    values = {
      site   = "",
      status = "",
      method = "",
    }
  }
  forward_to = [loki.write.argus.receiver]
}
